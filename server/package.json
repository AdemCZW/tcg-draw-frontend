{
  "name": "vaultdraw-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --sourcemap",
    "start": "node dist/index.js",
    "check": "node scripts/sync-shared.mjs --check && tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "selftest": "tsx src/selftest.ts",
    "seed": "tsx src/seed.ts",
    "smoke": "tsx src/smoke.ts",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
