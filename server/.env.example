# Railway 會自動注入 DATABASE_URL；本機開發自己填
DATABASE_URL=postgres://user:pass@localhost:5432/vaultdraw
# 簽 JWT 用。正式環境務必換掉，長度至少 32
JWT_SECRET=change-me-to-a-long-random-string-please
PORT=8080
# 允許的前端來源，逗號分隔
CORS_ORIGINS=http://localhost:5173,https://ademczw.github.io

# LINE Login（LINE Developers → 你的 channel → Basic settings）
LINE_CHANNEL_ID=2011159689
LINE_CHANNEL_SECRET=
# 後端與前端對外網址，組 OAuth 的 redirect 用
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Cloudflare R2（S3 相容），檔案上傳用。四項都沒填時 /v1/files/* 回 503，其他功能照常
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 可選：bucket 開了公開讀取才填（r2.dev 開發網域或自訂網域）。不填就全部走簽名網址
R2_PUBLIC_URL=

# PSA 鑑定編號查證（見 src/psa.ts、docs/psa-api-access.md）。
# token 只從這裡來，絕不進前端 bundle。沒設時查證回 not_configured，開池不硬擋（標 pending）。
PSA_API_TOKEN=
# 可覆寫 base（測試指向假伺服器用）；正式留空走預設官方網址
PSA_API_BASE=https://api.psacard.com/publicapi
# 明天 PSA 核准、API 開始回 ok 之後，把這個設成 1 就從「暫不驗證」切成「強制驗證」。
# 預設 0（不強制）：API 現在全 403，強制等於完全開不了鑑定卡的池。
PSA_VERIFY_ENFORCE=0
# 測試專用：設 1 時查證走內建 stub 而不打真的 PSA（見 src/psa.ts 的 stubExchange）。正式不要設。
PSA_STUB=
