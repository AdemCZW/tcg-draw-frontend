# Railway 會自動注入 DATABASE_URL；本機開發自己填
DATABASE_URL=postgres://user:pass@localhost:5432/vaultdraw
# 簽 JWT 用。正式環境務必換掉，長度至少 32
JWT_SECRET=change-me-to-a-long-random-string-please
PORT=8080
# 允許的前端來源，逗號分隔
CORS_ORIGINS=http://localhost:5173,https://ademczw.github.io

# LINE Login（LINE Developers → 你的 channel → Basic settings）
LINE_CHANNEL_ID=2011159689
LINE_CHANNEL_SECRET=
# 後端與前端對外網址，組 OAuth 的 redirect 用
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
