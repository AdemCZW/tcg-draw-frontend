#!/bin/sh
# 提交前的守門。
#
# ── 為什麼需要 ──────────────────────────────────────────────────────
# 2026-08-28 出過一次事：後端改完要提交時用了 `git add -A`，而當下有一支
# 背景 agent 正在同一個工作樹寫前端檔案。結果它**還沒完工的 1,038 行**被
# 掃進那個 commit 推上正式環境，而 commit 訊息完全沒提到它們。
# 那次沒炸掉是運氣 —— agent 的程式碼碰巧是完整可編譯的。早三十秒提交，
# 推上線的就會是一個寫到一半的檔案，前端建置失敗、網站掛掉。
#
# 這支 hook 是那件事的機械式防線。它擋不住「我不小心多加了檔案」，
# 但擋得住那件事真正的後果：**把一份建不起來的程式碼推出去**。
# （已經擋下來過一次：漏暫存 src/lib/api.ts 的那筆。）
#
# ── 要問的問題是「這個 commit 本身建不建得起來」 ────────────────────
# 不是「工作樹建不建得起來」。兩者在有未暫存變更時會分岔：未暫存的檔案
# 可能剛好補上了暫存區缺的東西，於是工作樹建得起來、推出去的 commit
# 卻建不起來。所以一定要在「只有暫存區內容」的樹上建。
#
# ── 為什麼從暫存區導出，而不是 stash ────────────────────────────────
# 前一版用 `git stash push --keep-index -u` 把未暫存的部分藏起來再建。
# 那個作法會**動到工作樹**，而這個專案常常有好幾支背景 agent 同時在寫
# 同一棵樹 —— 等於在別人打字的時候把檔案抽走。2026-08-31 就發生了：
# agent 在 stash 期間又寫了一次同樣的檔案，pop 因此失敗，未暫存的變更
# 被留在 stash list 裡（那次逐檔比對過，沒有東西遺失，但那是運氣）。
#
# `git checkout-index` 把暫存區的內容原樣倒進一個暫時目錄，在那裡建置。
# 問的是同一個問題，卻一個位元組都不碰工作樹，agent 可以繼續寫。
# 順帶還比較快（4.5 秒 vs stash 那套的來回）。
#
# node_modules 用 symlink 而不是複製：那是唯一體積大到會讓這件事變慢的
# 東西，而且它不在版控裡、內容與 commit 無關。

set -e

# 沒有暫存任何東西就不用驗（例如 git commit --amend --no-edit 之類）
git diff --cached --quiet && exit 0

# 只有動到前端原始碼才需要建置。改的全是後端或文件時，
# 跑一次前端建置只是懲罰。
if ! git diff --cached --name-only | grep -qE '^(src/|index\.html|vite\.config\.ts|package(-lock)?\.json)'; then
  exit 0
fi

echo "[pre-commit] 前端有改動，驗證這個 commit 本身建得起來…"

ROOT=$(git rev-parse --show-toplevel)
TMP=$(mktemp -d "${TMPDIR:-/tmp}/precommit-XXXXXX")
# 任何離開路徑都要清掉暫時目錄：建置失敗、Ctrl+C、hook 自己出錯。
trap 'rm -rf "$TMP"' EXIT INT TERM

git checkout-index -a --prefix="$TMP/"
ln -s "$ROOT/node_modules" "$TMP/node_modules"

if (cd "$TMP" && npm run build) >/tmp/precommit-build.log 2>&1; then
  echo "[pre-commit] 建置通過"
else
  echo ""
  echo "[pre-commit] ✗ 這個 commit 建不起來，提交已中止。"
  echo "  最後 20 行："
  tail -20 /tmp/precommit-build.log | sed 's/^/    /'
  echo ""
  echo "  完整記錄：/tmp/precommit-build.log"
  echo "  常見原因：暫存了 agent 寫到一半的檔案，或漏暫存了某個相依的檔案。"
  echo "  真的要跳過（很少該這樣）：git commit --no-verify"
  exit 1
fi
